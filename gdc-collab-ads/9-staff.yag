{{$collabConstants := (dbGet 0 "collabConstants").Value}}
{{$args := .CmdArgs }}
{{/*Note: tbf is string, limited to true/false/bypassed*/}}
{{$keyMethods := $collabConstants.keyMethods}}
{{$boolTxt := cslice true (cslice "true" "t" "yes" "y") false (cslice "false" "f" "no" "n")}}
{{$tfb := cslice "true" (cslice "true" "t" "yes" "y") "false" (cslice "false" "f" "no" "n") "bypassed" (cslice "bypassed" "bypass" "b")}}
{{$timer := $collabConstants.dbTimer}}
{{$ccid := $collabConstants.execCCID}}
{{$err := ""}}

{{define "SK"}}
	{{$user := .us}}
	{{$data := .da}}
	{{$timer := .ti}}
	{{$ccid := .cc}}
	{{$who := .who}}
	{{$channel := .ch}}
	{{dbSetExpire $user "collabUserData" $data $timer}}
	{{execCC $ccid $channel 0 (sdict "fireupdate" $user "staff" $who "edit" "")}}
{{end}}

{{if not $args}}
	{{sendMessage nil (componentBuilder "container" (sdict "components" (componentBuilder "text" $collabConstants.helpP)))}}
{{else}}
	{{$sub := index $args 0}}
	{{if eq $sub "help"}}
		{{sendMessage nil (componentBuilder "container" (sdict "components" (componentBuilder "text" $collabConstants.helpP)))}}
	{{else if eq $sub "show" "whitelist" "cdoff" "freeze" "unfreeze" "rempost" "wandclear" "wand"}}
		{{$args0 := parseArgs 2 "" (carg "string" "subcommand") (carg "userid" "user ID") (carg "string" "option")}}
		{{$user := $args0.Get 1}}
		{{if $collabUserData := (dbGet $user "collabUserData").Value}}
			{{$SL := sdict "us" $user "da" $collabUserData "ti" $timer "cc" $ccid "who" .User.ID "ch" $collabUserData.tID}}
			{{if eq $sub "show" "wandclear" "wand"}}
				{{if eq $sub "wandclear"}}
					{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "Are you sure you want to clear <@" $user ">'s (`" $user "`) collab ad data, as well as their template and collab post (if applicable)?") "buttons" (cbutton "custom_id" (print "collabs-nuke-" $user) "label" "Yes!" "style" "danger"))}}
				{{else if eq $sub "show"}}
					{{if $args0.IsSet 2}}
						{{$sub0 := $args0.Get 2}}
						{{$err := print "No key named `" $sub0 "`, use `-ca wandterms` or `-ca wandlist`to see what keys are valid. **The keys are case sensitive**."}}
						{{range $k, $v := $keyMethods}}
							{{if eq $k $sub0}}
								{{$sent := componentBuilder "allowed_mentions" (sdict "users" (cslice)) "text" (print "<@" $user ">'s (`" $user "`) " $v.name ":")}}
								{{$TH := $collabUserData.Get $k}}
								{{$nope := componentBuilder "container" (sdict "components" (componentBuilder "text" "*empty*"))}}
								{{if eq $v.type "thumb"}}
									{{if $TH}}
										{{$sent.Add "container" (sdict "components" (componentBuilder "gallery" (sdict "media" $TH)))}}
									{{else}}
										{{$sent.Merge $nope}}
									{{end}}
									{{sendMessage nil $sent}}
								{{else if eq $v.type "slice"}}
									{{if $TH}}
										{{$THI := cslice}}
										{{range $TH}}
											{{$THI = $THI.Append (sdict "media" .)}}
										{{end}}
										{{$sent.Add "container" (sdict "components" (componentBuilder "gallery" $THI))}}
										{{sendMessage nil $sent}}
									{{else}}
										{{$sent.Merge $nope}}
									{{end}}
								{{else}}
									{{if $TH}}
										{{$sent.Add "container" (sdict "components" (componentBuilder "text" (print $TH)))}}
										{{sendMessage nil $sent}}
									{{else}}
										{{$sent.Merge $nope}}
									{{end}}
								{{end}}
								{{$err = ""}}
								{{break}}
							{{end}}
						{{end}}
						{{if $err}}
							{{sendMessage nil $err}}
						{{end}}
					{{else}}
						{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "file" (json $collabUserData true) "content" (print "Here is <@" $user ">'s (`" $user "`) collab user data, in a text file:"))}}
					{{end}}
				{{else if eq $sub "wand"}}
					{{$args0 = parseArgs 4 "" (carg "string" "subcommand") (carg "userid" "user ID") (carg "string" "set/remove") (carg "string" "key")}}
					{{$RG := $args0.Get 2}}
					{{$sub0 := $args0.Get 3}}
					{{if eq $RG "remove"}}
						{{$err = "No valid key provided, use `-ca wandterms` or `-ca wandlist`to see what keys are valid. **The keys are case sensitive**."}}
						{{range $k, $v := $keyMethods}}
							{{if eq $k $sub0}}
								{{$collabUserData.Set $k ($collabConstants.collabUserData.Get $k)}}
								{{$SK := execTemplate "SK" $SL}}
								{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "Removed key `" $k "` from <@" $user ">."))}}
								{{$err = false}}
								{{break}}
							{{end}}
						{{end}}
					{{else if eq $RG "set"}}
						{{$args0 = parseArgs 5 "" (carg "string" "subcommand") (carg "userid" "user ID") (carg "string" "set/remove") (carg "string" "key") (carg "string" "value")}}
						{{$sub0 = $args0.Get 3}}
						{{$sub1 := $args0.Get 4}}
						{{$err = print "No key named `" $sub0 "`, use `-ca wandterms` or `-ca wandlist`to see what keys are valid. **The keys are case sensitive**."}}
						{{range $k, $v := $keyMethods}}
							{{if eq $k $sub0}}
								{{if eq $v.type "int64"}}
									{{$val := toInt64 $sub1}}
									{{if $val}}
										{{$collabUserData.Set $k $val}}
										{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $sub1 "`." ))}}
										{{$SK := execTemplate "SK" $SL}}
									{{else}}
										{{sendMessage nil (print "`" $sub1 "` is not a valid int64 value.")}}
									{{end}}
								{{else if eq $v.type "string"}}
									{{if $v.HasKey "choice"}}
										{{$err = print "The term `" $sub1 "` is not a valid choice from the key `" $k "`. Accepted values:\n"}}
										{{range $v.choice}}
											{{if eq $sub1 .}}
												{{$err = ""}}
												{{$collabUserData.Set $k .}}
												{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $sub1 "`." ))}}
												{{$SK := execTemplate "SK" $SL}}
												{{break}}
											{{end}}
											{{$err = print $err "- `" . "`\n"}}
										{{end}}
										{{if $err}}
											{{sendMessage nil $err}}
										{{end}}
									{{else if $v.HasKey "limit"}}
										{{$err = ""}}
										{{$val := $sub1}}
										{{if gt (len $sub1) $v.limit}}
											{{$val = slice $sub1 0 $v.limit}}
											{{$err = " String truncated due to the length limit."}}
										{{end}}
										{{$collabUserData.Set $k $val}}
										{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $val "`." $err))}}
									{{else}}
										{{$collabUserData.Set $k $sub1}}
										{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $sub1 "`."))}}
									{{end}}
									{{$SK := execTemplate "SK" $SL}}
								{{else if eq $v.type "tfb"}}
									{{$n := ""}}
									{{if eq $sub1 "true" "t" "yes" "y" "1"}}
										{{$n = "true"}}
										{{$collabUserData.Set $k $n}}
									{{else if eq $sub1 "false" "f" "no" "n" "0"}}
										{{$n = "false"}}
										{{$collabUserData.Set $k $n}}
									{{else if eq $sub1 "bypassed" "bypass" "b" "2"}}
										{{$n = "bypassed"}}
										{{$collabUserData.Set $k $n}}
									{{else}}
										{{sendMessage nil (print print "The term `" $sub1 "` is not a valid choice from the key `" $k "`. Accepted values:\n"
									"- **true**: true, t, yes, y, 1\n"
									"- **false**: false, f, no, n, 0\n"
									"- **bypassed**: bypassed, bypass, b, 2")}}
									{{return}}
									{{end}}
									{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $n "`."))}}
									{{$SK := execTemplate "SK" $SL}}
								{{else if eq $v.type "bool"}}
									{{$n := true}}
									{{if eq $sub1 "true" "t" "yes" "y" "1"}}
										{{$collabUserData.Set $k $n}}
									{{else if eq $sub1 "false" "f" "no" "n" "0"}}
										{{$n = false}}
										{{$collabUserData.Set $k $n}}
									{{else}}
										{{sendMessage nil (print print "The term `" $sub1 "` is not a valid choice from the key `" $k "`. Accepted values:\n"
									"- **true**: true, t, yes, y, 1\n"
									"- **false**: false, f, no, n, 0\n")}}
									{{return}}
									{{end}}
									{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "`" $k "` from <@" $user "> has been set to `" $n "`."))}}
									{{$SK := execTemplate "SK" $SL}}
								{{else if eq $v.type "thumb"}}
									{{sendMessage nil "Coming soon!"}}
								{{else if eq $v.type "array"}}
									{{sendMessage nil "Coming soon!"}}
								{{end}}
								{{$err = ""}}
								{{break}}
							{{end}}
						{{end}}
						{{if $err}}
							{{sendMessage nil $err}}
						{{end}}
					{{else}}
						{{sendMessage nil "Invalid command:\n- `-ca wand <@user> remove <key>`\n- `-ca wand <@user> set <key> <value/s>`"}}
					{{end}}
				{{else}}
					{{sendMessage nil (print "Error, <@661882006719954953> needs attention: " $sub ", point to show/wand/wandclear if-else")}}
				{{end}}
			{{else}}
				{{if $collabUserData.tID}}
					{{if eq $sub "whitelist"}}
						{{if eq "true" $collabUserData.AMod $collabUserData.AMo2}}
							{{if eq $collabUserData.AMod "true"}}
								{{$collabUserData.Set "AMod" "bypassed"}}
							{{end}}
							{{if eq $collabUserData.AMo2 "true"}}
								{{$collabUserData.Set "AMo2" "bypassed"}}
							{{end}}
							{{$SK := execTemplate "SK" $SL}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user "> is now AutoMod whitelisted."))}}
						{{else}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user "> is not blacklisted."))}}
						{{end}}
					{{else if eq $sub "cdoff"}}
						{{$time := $collabUserData.time}}
						{{$bumpTime := add $time (toInt64 $collabConstants.collabCD)}}
						{{if and $collabUserData.fID (lt currentTime $bumpTime)}}
							{{$collabUserData.Set "time" $bumpTime}}
							{{$SK := execTemplate "SK" $SL}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user "> can now bump up their collab ad."))}}
						{{else}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user "> has not posted their collab ad yet, or they can bump up their collab ad just fine."))}}
						{{end}}
					{{else if eq $sub "freeze"}}
						{{$collabUserData.Set "flag" "freeze"}}
						{{$SK := execTemplate "SK" $SL}}
						{{sendMessage nil (complexMessage  "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user ">'s template is now frozen."))}}
					{{else if eq $sub "unfreeze"}}
						{{$collabUserData.Set "flag" "neutral"}}
						{{$SK := execTemplate "SK" $SL}}
						{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user ">'s template is now unfrozen."))}}
					{{else if eq $sub "rempost"}}
						{{$DL := $collabUserData.fID}}
						{{if (getThread $DL)}}
							{{$collabUserData.Set "fID" (toInt64 0)}}
							{{$collabUserData.Set "fmID" (toInt64 0)}}
							{{deleteForumPost $DL}}
							{{$SK := execTemplate "SK" $SL}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user ">'s collab ad post has been deleted."))}}
						{{else}}
							{{sendMessage nil (complexMessage "allowed_mentions" (sdict "users" (cslice)) "content" (print "<@" $user "> has not posted their collab ad yet."))}}
						{{end}}
					{{end}}
				{{else}}
					{{sendMessage nil (print "Cannot use the command `-ca " $sub "` due to the absence of collab template from <@" $user "> (`" $user "`).")}}
				{{end}}
			{{end}}
		{{else}}
			{{sendMessage nil (complexMessage  "allowed_mentions" (sdict "users" (cslice)) "content" (print "No collab data found for <@" $user "> (`" $user "`)."))}}
		{{end}}
	{{else if eq $sub "wandterms" "wandlist" "website" "automod"}}
		{{if eq $sub "wandterms" "wandlist"}}
			{{sendMessage nil (componentBuilder "container" (sdict "components" (componentBuilder "text" $collabConstants.helpK) ) )}}
		{{end}}
	{{else}}
		{{sendMessage nil (componentBuilder "text" (print "No command named `" $sub "`.") "container" (sdict "components" (componentBuilder "text" $collabConstants.helpP)))}}
	{{end}}
{{end}}