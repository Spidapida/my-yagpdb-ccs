{{$report :=  sdict "emoji" (sdict "name" "⚠") "label" "Report Collab" "custom_id" "collabs-report" "style" "danger"}}

{{$keyMethods := sdict "tID" (sdict "name" "(template) thread ID" "type" "int64")
"tmID" (sdict "name" "(template) message ID" "type" "int64")
"flag" (sdict "name" "user flag" "type" "string" "choice" (cslice "neutral" "manageMedia" "manageThumbnail" "deleteCollab" "freeze"))
"AMod" (sdict "name" "AutoMod status" "type" "tfb")
"term" (sdict "name" "AutoMod string flagged" "type" "string")
"staff" (sdict "name" "staff status" "type" "bool")
"boost" (sdict "name" "booster status" "type" "bool")
"L20UP" (sdict "name" "priority status (Level 20, QC, Event Winner)" "type" "bool")
"CT" (sdict "name" "collab title" "type" "string" "limit" 100)
"CP" (sdict "name" "collab description" "type" "string" "limit" 3900)
"CI" (sdict "name" "Discord invite" "type" "string" "limit" 255)
"CC" (sdict "name" "collab contribution" "type" "string" "limit" 200)
"CZ" (sdict "name" "collab size" "type" "string" "choice" (cslice "Small Scale Collab" "Megacollab" "Ultracollab"))
"LS" (sdict "name" "level decoration style" "type" "string" "choice" (cslice "Modern" "Glow Design" "Effect" "Core" "Art" "Minigame" "Neodesign" "Layouts" "Other"))
"CN" (sdict "name" "collab needs" "type" "string" "choice" (cslice "Decoration Only" "Gameplay Only" "Decoration & Gameplay" "Other"))
"LD" (sdict "name" "level difficulty" "type" "string" "choice" (cslice "Non-Demon" "Easy-Medium Demon" "Hard-Insane Demon" "Extreme Demon"))
"LT" (sdict "name" "level type" "type" "string" "choice" (cslice "Classic" "Platformer"))
"CS" (sdict "name" "collab standards" "type" "string" "choice" (cslice "Low Standards" "Medium Standards" "High Standards"))
"CH" (sdict "name" "collab host" "type" "string" "limit" 33)
"LM" (sdict "name" "level music" "type" "string" "limit" 500)
"CF" (sdict "name" "collab thumbnail" "type" "thumb")
"CM" (sdict "name" "collab media" "type" "slice")
"nID" (sdict "name" "message ID for notifications" "type" "int64")
"nTok" (sdict "name" "interaction token for ephemeral notifications" "type" "string")
"fID" (sdict "name" "thread ID for posted collab ad" "type" "int64")
"fmID" (sdict "name" "second message ID for posted collab ad" "type" "int64")
"time" (sdict "name" "timestamp of posted collab ad" "type" "int64")
"no4WM" (sdict "name" "message ID of media gallery not forwarded" "type" "int64")
"no4WF" (sdict "name" "message ID of thumbnail not forwarded" "type" "int64")
"msk" (sdict "name" "masked link status" "type" "bool")
"CTTM" (sdict "name" "collab title timestamp edit" "type" "int64")
"nmID" (sdict "name" "message ID from setting media/thumbnail" "type" "int64")
"AMo2" (sdict "name" "AutoMod status for Level Music" "type" "tfb")
"ter2" (sdict "name" "AutoMod string flagged for Level Music" "type" "string")}}

{{$p := sdict
"helpP" $help1
"helpK" $help2
"keyMethods"	$keyMethods
"r0"			$r0
"r1"			$r1
"r2"			$r2
"r3"			$r3
"r4"			$r4
"r5"			$r5
"r6"			$r6
"r7"			$r7
"r8"			$r8
"r9"			$r9
"ra"			$ra
"rb"			$rb
"rc"			$rc
"rd"			$rd
"re"			$re
"rf"			$rf
"rg"			$rg
"rh"			$rh
"ri"			$ri
"rj"			$rj
"rk"			$rk
"rl"			$rl
"rm"			$rm
"rn"			$rn
"ro"			$ro
"rp"			$rp
"e0"			$e0
"e1"			$e1
"a"				$a
"b"				$b
"c"				$c
"d"				$d
"e"				$e
"f"				$f
"g"				$g
"h"				$h
"i"				$i
"j"				$j
"report"		$report}}
{{if $collabConstants := (dbGet 0 "collabConstants").Value}}
	{{range $k, $v := $p}}
		{{$collabConstants.Set $k $v}}
	{{end}}
	{{dbSet 0 "collabConstants" $collabConstants}}
	{{sendMessage nil "Adding details finished. Proceed to next step."}}
{{else}}
    {{sendMessage nil "Adding failed because database was not initiated. Please read the instructions."}}
{{end}}