{{$MDiff := sdict "custom_id" "lvlDiff" "type" "text" "placeholder" "Select one here" "required" true}} {{/* cmenu */}}
{{$ODiff := cslice (sdict "emoji" (sdict "id" "1198512511188738058") "label" "Auto" "value" "Auto")
(sdict "emoji" (sdict "id" "1198512542008483860") "label" "Easy" "value" "Easy")
