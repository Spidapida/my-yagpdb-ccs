{{$topOne := 1}}
{{$topTwo := 2}}
{{$topThree := 3}}

{{$noticeCC := 69}}
{{$deadline := 2592000}} {{/* 2592000 seconds = 30 days */}}

{{$formats := cslice "webm" "mp4" "mov"}}

{{$TILvlID := sdict "custom_id" "lvlID" "placeholder" "i.e., 104187415" "required" true "max_length" 9 "min_length" 1 "style" 1}} {{/* clabel */}}
{{$LLvlID := sdict "label" "Level ID" "description" "Only one level is allowed per request."}} {{/* ctextInput */}}

{{$LLen := sdict  "label" "Level Length Completion" "description" "How long to complete the level?"}} {{/* clabel */}}
{{$MLen := sdict "custom_id" "lvlLen" "type" "text" "placeholder" "Select one here" "required" true}} {{/* cmenu */}}
{{$OLen := cslice (sdict "label" "Tiny (0 - 10 seconds)" "value" "Tiny (0 - 10 seconds)")
(sdict "label" "Short (10 - 30 seconds)" "value" "Short (10 - 30 seconds)")
(sdict "label" "Medium (30 - 60 seconds)" "value" "Medium (30 - 60 seconds)")
