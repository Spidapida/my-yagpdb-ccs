{{/* Modal: record-

PLS SANITIZE EVERY TEXTS TO AVOID THE BIG HOOPLA HOPLA HOOP OF PEOPLE BREAKING THE TEXT, try printf %q :3

*/}}

{{$recConst := (dbGet 0 "recConst").Value}}
{{$userReq := $recConst.userReq}}
{{$userMesID := $recConst.userMesID}}
{{$council := false}}
{{$IT := .Interaction.Token}}

{{range $recConst.council}}
	{{if hasRoleID .}}
		{{$council = true}}
		{{break}}
	{{end}}
{{end}}

{{if eq .CustomID "record-lbNavJump"}}
	{{$title := (index .Message.Components 0).Content}}
	{{$page := toInt .ModalValues.page.value}}
	{{$leaderboard := cslice}}
	{{$dbName := $recConst.dbName}}
	{{if eq $title "## Recording Leaderboard"}}
		{{$dbName = "footageRecords"}}
	{{else}}
		{{$title = print "## " $recConst.posterMonthName " Recording Leaderboard"}}
	{{end}}
	{{$maxPage := toInt (roundCeil (fdiv (dbCount $dbName) 10))}}
	{{if lt $page 1}}
		{{$page = 1}}
	{{else if gt $page $maxPage}}
		{{$page = $maxPage}}
	{{end}}
	{{$leaderboard = dbTopEntries $dbName 10 (mult (sub $page 1) 10)}}
	
	{{$navFirst := $recConst.navFirst}}
	{{$navPrev := $recConst.navPrev}}
	{{$navJump := $recConst.navJump}}
	{{$navNext := $recConst.navNext}}
	{{$navLast := $recConst.navLast}}
	{{if gt $page 1}}
		{{$navPrev.Set "custom_id" (print "record-lbNav " (sub $page 1))}}
	{{else}}
		{{$navPrev.Set "disabled" true}}
	{{end}}
	{{if le $page 2}}
		{{$navFirst.Set "custom_id" (print "record-lbNavFirst")}}
		{{$navFirst.Set "disabled" true}}
	{{end}}
	{{if lt $page $maxPage}}
		{{$navNext.Set "custom_id" (print "record-lbNav " (add $page 1))}}
	{{else}}
		{{$navNext.Set "disabled" true}}
	{{end}}
	{{if gt (add $page 2) $maxPage}}
		{{$navLast.Set "disabled" true}}
	{{else}}
		{{$navLast.Set "custom_id" (print "record-lbNav " $maxPage)}}
	{{end}}
	
	{{$tally := ""}}
	{{$num := add (mult (sub $page 1) 10) 1}}
	{{range $leaderboard}}
		{{$tally = print $tally $num ". `" .Value "` **-** <@" .User.ID ">\n"}}
		{{$num = add $num 1}}
	{{end}}
	{{updateMessageNoEscape (componentBuilder "allowed_mentions" (sdict "users" (cslice .User.ID)) "text" $title "container" (sdict "components" (componentBuilder "text" $tally)) "container" (sdict "components" (componentBuilder "buttons" (cslice (cbutton $navFirst) (cbutton $navPrev) (cbutton $navJump) (cbutton $navNext) (cbutton $navLast)) "text" (print "Page `" $page " / " $maxPage "`"))))}}
	{{return}}
{{end}}

{{range $recConst.restricted}}
	{{if and (hasRoleID .) (not $council)}}
		{{sendResponse nil (complexMessage "ephemeral" true "content" (print "You are not allowed to perform this action due to presence of <@&" . ">."))}}
		{{return}}
		{{break}}
	{{end}}
{{end}}

{{if eq .CustomID "record-requestSubmit"}}
	{{sendResponse nil (complexMessage "content" "Processing your request..." "ephemeral" true)}}
	{{$lvlID := reFind `\d{2,9}` .ModalValues.lvlID.value}}
	{{if not $lvlID}}
		{{sendMessage nil "Invalid level ID."}}
		{{return}}
	{{end}}

	{{$fetch := sendMessageRetID $recConst.recTemp (print "https://gdbrowser.com/" $lvlID)}}
	{{$regex := `(?i) by [ a-z0-9\-]+$`}}
	{{$embed := sdict}}
	{{range 5}}
		{{sleep 1}}
		{{$info := getMessage $recConst.recTemp $fetch}}
		{{if $info.Embeds}}
			{{$embed = index $info.Embeds 0}}
			{{break}}
		{{end}}
	{{end}}
	{{$msg := $recConst.lastID}}
	{{$Z := 0}}
	{{$lvlName := ""}}
	{{$creator := ""}}
	{{$star := ""}}
	{{$inDiff := ""}}
	{{$inLen := ""}}
	{{$kind := "Classic"}}
	{{$inSong := ""}}
	{{$download := ""}}
	{{$notes := "*empty*"}}
	{{if $NT := .ModalValues.notes.value}}
		{{$notes = reReplace `[\*_~\x60\|\n]` $NT " "}}
	{{end}}

	{{if $embed}}
		{{if eq $embed.Title "Level Search"}}
			{{editResponse $IT nil $recConst.respLvlInv}}
			{{return}}
		{{else}}
			{{$lvlName = reReplace $regex $embed.Title ""}}
			{{$creator = slice (reFind $regex $embed.Title) 4}}
			{{$LS := split $embed.Description " | "}}
			{{$star = slice (index $LS 1) 7}}
			{{$inDiff = slice (index $LS 2) 12}}
			{{if eq $star "0"}}
				{{$inDiff = index .ModalValues.lvlDiff.value 0}}
			{{end}}
			{{$inLen = slice (index $LS 5) 8}}
			{{if eq $inLen "Plat"}}
				{{$kind = "Platformer"}}
			{{end}}
			{{/* {{$likes := slice (index $LS 4) 7}} */}}
			{{$inLen = index .ModalValues.lvlLen.value 0}}
			{{$inSong = slice (index $LS 6) 6}}
			{{$download = slice (index $LS 3) 11}}
			{{$str0 := ":** "}}
			{{$songDisp := ""}}
			{{if $indS := reFind .LinkRegex .ModalValues.lvlSong.value}}
				{{$inSong = $indS}}
				{{$str0 = " (NONG):** "}}
			{{else}}
				{{$eo := reFind `\(\w{1,}\)$` $inSong}}
				{{$re := reFind `\d{1,7}` $eo}}
				{{if (in $eo "Level")}}
				{{else if (reFind `\d{8,}` $eo)}}
				{{else if $re}}
					{{$songDisp = print "[" $inSong "](https://www.newgrounds.com/audio/listen/" $re ")"}}
				{{end}}
			{{end}}
			{{$Z = componentBuilder "allowed_mentions" (sdict "users" (cslice .User.ID)) "container" (sdict "components" (componentBuilder "text" (print "### " .User.Mention "'s request") "separator" true "text" (print
			"### Level Info:"
			"\n- **Level Name:** " $lvlName
			"\n- **Creator:** " $creator
			"\n- **Level ID:** `" $lvlID
			"`\n- **Downloads:** " $download
			"\n- **Level Type:** " $kind) "separator" true "text" (print
			"### Recording Info:"
			"\n- **Level Difficulty:** " $inDiff
			"\n- **Level Length Completion:** " (index .ModalValues.lvlLen.value 0)
			"\n- **Level Music" $str0 (or $songDisp $inSong)
			"\n- **Additional Notes:** " $notes )))}}
		{{end}}
	{{else}}
		{{$Z = componentBuilder "allowed_mentions" (sdict "users" (cslice .User.ID)) "container" (sdict "components" (componentBuilder "text" (print "### " .User.Mention "'s request") "separator" true "text" (print
		"### Could not fetch level data, please verify the info of the level manually using <@1439081767574311055> (via </level:1454737867514314793> in <#643104805707055130>)."
		"\n\n- **Level ID:** " $lvlID
		"\n- **Level Difficulty:** " (index .ModalValues.lvlDiff.value 0)
		"\n- **Level Length Completion:** " (index .ModalValues.lvlLen.value 0)
		"\n- **Level Music:** " (or .ModalValues.lvlSong.value "*included in the level*")
		"\n- **Additional Notes:** " $notes)))}}
	{{end}}
	{{$V := sdict "rID" .User.ID "date" currentTime.Unix "lvlID" $lvlID "lvlLen" $inLen "lvlDiff" $inDiff "lvlSong" $inSong "notes" $notes "lvlName" $lvlName "lvlCreator" $creator "lvlDL" $download "kind" $kind "submissions" (dict)}}
	{{$subBtn4 := $recConst.subBtn4}}
	{{$subBtn4.Set "custom_id" (print "record-requestDelete " .User.ID)}}
	{{$Z.Merge (componentBuilder "container" (sdict "components" (componentBuilder "buttons" (cslice (cbutton $recConst.subBtn3) (cbutton $subBtn4)))))}}
	{{$msgID := or ($userMesID.Get .User.ID) 1}}
	{{$data := $userReq.Get $msgID}}
	{{if $data}}
		{{editResponse $IT nil "Your request has been edited."}}
		{{editMessage nil $msgID $Z}}
		{{$V.Set "submissions" $data.submissions}}
		{{$userReq.Set $msgID $V}}
	{{else}}
		{{editResponse $IT nil "Your request has been submitted."}}
		{{editMessage nil $msg $Z}}
		{{$msg = (createThread nil $msg (print .User.Username "'s request submissions")).ID}}
		{{editThread $msg (sdict "slowmode" 60)}}
		{{sendMessage $msg "## To make a submission, simply send a message containing a video attachment, or video link."}}
		{{$new := sendMessageRetID nil (componentBuilder "container" (sdict "components" (componentBuilder "text" $recConst.desc01 "separator" true "text" $recConst.desc02 "separator" true "section" (sdict "text" $recConst.desc03 "button" (cbutton $recConst.reqBtn)) "separator" true "section" (sdict "text" $recConst.desc04 "button" (cbutton $recConst.scrollTop)))))}}
		{{$recConst.Set "lastID" $new}}
		{{$userReq.Set $msg $V}}
		{{$userMesID.Set .User.ID $msg}}
	{{end}}
	{{$recConst.Set "userReq" $userReq}}
	{{$recConst.Set "userMesID" $userMesID}}
	{{dbSet 0 "recConst" $recConst}}
{{else if inFold .CustomID "record-noticeRequest"}}
	{{$IDs := toInt64 (reFind `\d{17,19}` .CustomID)}}
	{{if $reason := .ModalValues.reason.value}}
		{{sendResponse nil (complexMessage "ephemeral" true "content" "Deleted + sent a notice!")}}
		{{execCC $recConst.noticeCC nil 1 (sdict "passed" (cslice $IDs) "reason" $reason)}}
	{{else}}
		{{sendResponse nil (complexMessage "ephemeral" true "content" "Deleted!")}}
	{{end}}
	{{$key := .Message.ID}}
	{{deleteThread $key}}
	{{deleteMessage .Channel.ID $key}}
	{{$recConst.userReq.Del $key}}
	{{$recConst.userMesID.Del $IDs}}
	{{dbSet 0 "recConst" $recConst}}
{{else if inFold .CustomID "record-noticeVideo"}}
	{{$IDs := toInt64 (reFind `\d{17,19}` .CustomID)}}
	{{if $reason := .ModalValues.reason.value}}
		{{sendResponse nil (complexMessage "ephemeral" true "content" "Deleted + sent a notice!")}}
		{{execCC $recConst.noticeCC nil 1 (sdict "passed" (cslice $IDs) "reason" $reason)}}
	{{else}}
		{{sendResponse nil (complexMessage "ephemeral" true "content" "Deleted!")}}
	{{end}}
	{{$req := $recConst.userReq.Get .Channel.ID}}
	{{$key := $req.submissions.Get $IDs}}
	{{deleteMessage .Channel.ID $key}}
	{{$req.submissions.Del $key}}
	{{$recConst.Set "userReq" $req}}
	{{dbSet 0 "recConst" $recConst}}
{{end}}